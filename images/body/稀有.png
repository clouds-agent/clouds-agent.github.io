<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>访问被禁止 - 一个小站</title>
    <style>
        :root {
            --main-color: #03c9a9;
            --text-color: #333;
            --bg-color: #f5f5f5;
            --accent-color: #ffa500;
        }
        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Helvetica Neue', Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
        }
        .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            height: 100%;
        }
        .left-panel {
            background-color: var(--main-color);
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        .shape {
            position: absolute;
            background-color: rgba(255, 255, 255, 0.1);
        }
        .shape-1 {
            width: 200px;
            height: 200px;
            top: 50px;
            left: 50px;
            clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
        }
        .shape-2 {
            width: 150px;
            height: 150px;
            bottom: 50px;
            right: 50px;
            clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
        }
        .right-panel {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 10% 10%;
            box-sizing: border-box;
            position: relative;
            overflow: hidden;
        }
        .background-text {
            position: absolute;
            font-size: 180px;
            font-weight: bold;
            color: rgba(0, 0, 0, 0.03);
            white-space: nowrap;
            right: 20px;
            bottom: 20px;
            transform: none;
        }
        .logo {
            width: 100px;
            margin-bottom: 20px;
        }
        h1 {
            font-size: 4em;
            margin-bottom: 0.2em;
            color: var(--accent-color);
            position: relative;
        }
        h2 {
            font-size: 1.5em;
            margin-top: 0;
            margin-bottom: 1em;
            color: var(--main-color);
            font-weight: 500;
        }
        p {
            font-size: 1.1em;
            line-height: 1.6;
            margin-bottom: 2em;
            position: relative;
        }
        .quote {
            font-style: italic;
            color: var(--accent-color);
            text-align: center;
            margin: 2em 0;
            padding: 1em;
            border-top: 1px solid #eee;
            border-bottom: 1px solid #eee;
        }
        .homepage-link {
            margin-top: 20px;
            color: var(--main-color);
            text-decoration: none;
            font-weight: bold;
        }
        .homepage-link:hover {
            text-decoration: underline;
        }
        .debug-info {
            font-size: 0.75em;
            color: #888;
            margin-top: 2em;
            padding: 1em;
            background-color: #f0f0f0;
            border-radius: 5px;
            line-height: 1.4;
        }
        @media (max-width: 768px) {
            .container {
                grid-template-columns: 1fr;
            }
            .left-panel {
                display: none;
            }
            .right-panel {
                padding: 10% 5%;
            }
            .background-text {
                font-size: 120px;
                right: 10px;
                bottom: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="left-panel">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
        </div>
        <div class="right-panel">
            <div class="background-text">403</div>
            <img src="https://cdn-bitiful-s4.ygxz.xyz/in/logo_clip.svg" alt="一个小站 Logo" class="logo">
            <h1>403</h1>
            <h2>访问被禁止</h2>
            <p>很抱歉，您没有权限访问此页面。如果您认为这是一个错误，请联系网站管理员。</p>
            <div class="quote" id="randomQuote"></div>
            <a href="https://www.ygxz.in/" class="homepage-link">返回首页</a>
            <div class="debug-info" id="debugInfo"></div>
        </div>
    </div>
    <script>
        const quotes = [
            "路遥知马力，日久见人心。",
            "有志者事竟成。",
            "虽有禁地，心无疆界。",
            "跋山涉水，不改初心。",
            "权限虽受限，创意无边界。",
            "一步受阻，不妨退而求其次。",
            "暂时受阻，未来可期。",
            "没有权限，但有远方。",
            "前路暂禁，心路无阻。"
        ];
        
        function getRandomQuote() {
            return quotes[Math.floor(Math.random() * quotes.length)];
        }
        
        document.getElementById('randomQuote').textContent = getRandomQuote();

        // Debug信息
        function getDebugInfo() {
            const debugInfo = {
                "请求ID": "1780623219114291000001",
                "时间": "2026-06-05T09:33:39.185+08:00",
                "客户端": "  / curl 7.88.1",
                "IP及位置": "47.254.31.20 (美国 加利福尼亚 圣克拉拉 - 阿里云)",
                "请求详情": "GET /gh/ohminecraftlauncher/ohminecraftlauncher.github.io/DIY/images/body/稀有.png",
                "Referer": "",
                "CDN节点": "US L2 (29)",
                "缓存状态": "MISS",
                "响应状态": "403 Forbidden",
                "响应时间": "0.000000ms"
            };
            return Object.entries(debugInfo)
                .map(([key, value]) => `<strong>${key}:</strong> ${value}`)
                .join('<br>');
        }

        document.getElementById('debugInfo').innerHTML = getDebugInfo();
    </script>
</body>
</html>